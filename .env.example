# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth secret: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts Gupshup API keys at rest: openssl rand -base64 32
# Never change it after keys are saved, or saved keys cannot be read.
ENCRYPTION_KEY=""

# Signs the bulk-send worker calls. Falls back to AUTH_SECRET if empty.
WORKER_SECRET=""

# Vercel cron auth (daily stalled-campaign sweep). Vercel sends it as a Bearer token.
CRON_SECRET=""

# Public URL of the production deployment, e.g. https://whatsapp-gupshup.vercel.app
# Used for webhook URLs and worker self-calls.
APP_URL=""

# Only for `npm run db:seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
